# Copy to .env.local. With the two Supabase values empty the app runs in demo mode.

# Supabase project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key (NOT the service_role key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only when hosted under a sub-path, e.g. /hot-streak-poker on GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# "Are you sure?" threshold for a single buy-in / cash-out / expense, in dollars. Default 2000.
NEXT_PUBLIC_LARGE_AMOUNT_DOLLARS=
